{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":automergeMinor",
    ":automergeBranch",
    ":rebaseStalePrs",
    ":semanticCommitScopeDisabled",
    ":preserveSemverRanges"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["/eslint/", "/prettier/"],
      "groupName": "ci"
    },
    {
      "matchPackageNames": ["/vite/"],
      "groupName": "build"
    },
    {
      "matchPackageNames": ["/vitest/", "rxjs-marbles"],
      "groupName": "test"
    }
  ]
}

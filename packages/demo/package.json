{
  "name": "@marking-menu/demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.playground.config.ts",
    "playground:build": "vite build --config vite.playground.config.ts",
    "playground:preview": "vite preview --config vite.playground.config.ts",
    "build": "yarn playground:build && rm -rf ../../demo-dist && mkdir -p ../../demo-dist/lib ../../demo-dist/playground && cp index.html demo.css demo.js ../../demo-dist/ && cp -R shared/. ../../demo-dist/shared/ && cp -L ../../node_modules/marking-menu/dist/marking-menu.js ../../node_modules/marking-menu/dist/marking-menu.js.map ../../demo-dist/lib/ && cp -R ../../playground-dist/. ../../demo-dist/playground/",
    "serve": "vite preview --outDir .",
    "preview": "vite preview --outDir ../../demo-dist"
  },
  "dependencies": {
    "marking-menu": "workspace:*"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "codemirror-json-schema": "^0.8.1",
    "json-schema": "^0.4.0",
    "json-schema-library": "^11.6.2",
    "json-schema-to-ts": "^3.1.1",
    "lucide-react": "^1.41.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "allowJs": true,
    "checkJs": true,
    // The demo resolves `marking-menu` through its import map and a link to
    // the installed workspace package. Type it from the same built bundle
    // so a type missing from what we publish fails here too.
    "paths": {
      "marking-menu": ["../../node_modules/marking-menu/dist/marking-menu.d.ts"]
    }
  },
  "include": ["**/*.js", "**/*.ts"],
  "exclude": [
    // Its own project (jsx, React types), not plain checkJs.
    "playground/**",
    // The built library itself, symlinked in for the browser; already
    // checked as its own source in the library workspace.
    "lib/**"
  ]
}

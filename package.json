{
  "name": "@marking-menu/workspace",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "scripts": {
    "test": "vitest run --project='!*(dist)*'",
    "test:watch": "vitest --project='!*(dist)*'",
    "typecheck": "yarn build && yarn typecheck:only",
    "typecheck:only": "tsc -b",
    "test:coverage": "vitest run --coverage --project='marking-menu (unit)' --project='marking-menu (browser) (chromium)'",
    "test:cross-browser": "vitest run --project='marking-menu (browser) (firefox)' --project='marking-menu (browser) (webkit)'",
    "test:dist": "yarn demo:build && yarn test:dist:only",
    "test:dist:only": "vitest run --project='*(dist)*'",
    "build": "yarn workspace marking-menu build",
    "build:watch": "yarn workspace marking-menu build:watch",
    "demo:build": "yarn build && yarn demo:build:only",
    "demo:build:only": "yarn workspace @marking-menu/demo build",
    "demo:dev": "yarn workspace @marking-menu/demo dev",
    "demo:preview": "yarn workspace @marking-menu/demo preview",
    "prepare": "yarn build",
    "changeset": "changeset",
    "release:publish": "yarn build && yarn package:lint && yarn package:smoke-test && yarn changeset publish",
    "lint": "yarn build && yarn lint:only",
    "lint:only": "eslint .",
    "lint:fix": "yarn build && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:lint": "yarn workspace marking-menu exec publint",
    "package:types": "attw --pack packages/marking-menu --profile esm-only",
    "package:smoke-test": "node scripts/smoke-test.ts"
  },
  "workspaces": [
    "packages/marking-menu",
    "packages/demo",
    "packages/collector"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "catalog:",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.9.1",
    "eslint-config-xo": "^4.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "catalog:",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "publint": "^0.3.24",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependenciesMeta": {
    "better-sqlite3": {
      "built": true
    }
  }
}

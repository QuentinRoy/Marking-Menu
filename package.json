{
  "name": "marking-menu",
  "version": "0.10.1",
  "description": "Marking Menu Implementation in JavaScript.",
  "license": "MIT",
  "repository": "github:QuentinRoy/Marking-Menu",
  "author": "Quentin Roy <quentin@quentinroy.fr>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/marking-menu.js"
    }
  },
  "sideEffects": false,
  "packageManager": "yarn@4.17.1",
  "scripts": {
    "test": "vitest run",
    "watch-test": "vitest",
    "typecheck": "tsc -b",
    "coverage": "vitest run --coverage",
    "build": "vite build",
    "build-demo": "yarn build && vite build --config vite.demo.config.ts",
    "dev": "vite --config vite.demo.config.ts",
    "watch": "vite build --watch",
    "prepare": "yarn build",
    "changeset": "changeset",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "smoke-test": "node scripts/smoke-test.ts",
    "serve": "yarn preview",
    "preview": "vite preview --config vite.demo.config.ts"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "interaction",
    "technique"
  ],
  "dependencies": {
    "raf-schd": "^4.0.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.24",
    "angles": "^0.5.1",
    "csv-parse": "^7.0.1",
    "eslint": "^10.8.0",
    "eslint-config-xo": "^0.58.1",
    "eslint-plugin-import-x": "^4.17.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "rxjs": "^7.8.2",
    "rxjs-marbles": "^7.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "rxjs": "^7.2.0"
  }
}

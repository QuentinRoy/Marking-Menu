{
  "name": "marking-menu",
  "version": "1.0.1",
  "description": "Marking Menu Implementation in JavaScript.",
  "license": "MIT",
  "repository": "github:QuentinRoy/Marking-Menu",
  "author": "Quentin Roy <quentin@quentinroy.fr>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/marking-menu.d.ts",
      "default": "./dist/marking-menu.js"
    }
  },
  "sideEffects": false,
  "packageManager": "yarn@4.18.0+sha224.5707fce90df5d8720fae4e85a07ab55e90aa20fded8914893e2ba225",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --project=browser",
    "typecheck": "yarn build && yarn typecheck:only",
    "typecheck:only": "tsc -b",
    "test:coverage": "vitest run --coverage",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "demo:build": "yarn build && yarn playground:build && rm -rf demo-dist && cp -RL demo/. demo-dist/ && rm -rf demo-dist/playground && mkdir demo-dist/playground && cp -R playground-dist/. demo-dist/playground/",
    "demo:serve": "vite preview --outDir demo",
    "demo:preview": "vite preview --outDir demo-dist",
    "playground:dev": "vite --config vite.playground.config.ts",
    "playground:build": "vite build --config vite.playground.config.ts",
    "playground:preview": "vite preview --config vite.playground.config.ts",
    "e2e": "yarn build && yarn e2e:build && yarn e2e:test",
    "e2e:build": "vite build --config e2e/vite.config.ts",
    "e2e:test": "playwright test --config e2e/playwright.config.ts",
    "prepare": "yarn build",
    "changeset": "changeset",
    "release:publish": "yarn build && yarn package:lint && yarn package:smoke-test && yarn changeset publish",
    "lint": "yarn build && yarn lint:only",
    "lint:only": "eslint .",
    "lint:fix": "yarn build && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:lint": "publint",
    "package:types": "attw --pack . --profile esm-only",
    "package:smoke-test": "node scripts/smoke-test.ts"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "interaction",
    "technique"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@microsoft/api-extractor": "^7.59.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "axe-core": "^4.13.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "codemirror-json-schema": "^0.8.1",
    "csv-parse": "^7.0.2",
    "eslint": "^10.9.1",
    "eslint-config-xo": "^4.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "json-schema": "^0.4.0",
    "json-schema-library": "^11.6.2",
    "json-schema-to-ts": "^3.1.1",
    "lightningcss": "^1.33.0",
    "lucide-react": "^1.41.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "publint": "^0.3.24",
    "pure-rand": "^8.4.2",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simplex-noise": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "totorobot": "^3.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  }
}

{
  "name": "marking-menu",
  "version": "0.10.1",
  "description": "Marking Menu Implementation in JavaScript.",
  "license": "MIT",
  "repository": "github:QuentinRoy/Marking-Menu",
  "author": "Quentin Roy <quentin@quentinroy.fr>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "test:coverage": "vitest run --coverage",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "demo:build": "yarn build && vite build --config vite.demo.config.ts",
    "demo:dev": "vite --config vite.demo.config.ts",
    "demo:preview": "vite preview --config vite.demo.config.ts",
    "e2e": "yarn build && yarn e2e:build && yarn e2e:test",
    "e2e:build": "vite build --config e2e/vite.config.ts",
    "e2e:test": "playwright test --config e2e/playwright.config.ts",
    "prepare": "yarn build",
    "changeset": "changeset",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:lint": "publint",
    "package:types": "attw --pack . --profile esm-only",
    "package:smoke-test": "node scripts/smoke-test.ts"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "interaction",
    "technique"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@microsoft/api-extractor": "^7.59.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "angles": "^0.5.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "codemirror-json-schema": "^0.8.1",
    "csv-parse": "^7.0.2",
    "eslint": "^10.9.1",
    "eslint-config-xo": "^2.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "json-schema": "^0.4.0",
    "json-schema-library": "^11.6.2",
    "json-schema-to-ts": "^3.1.1",
    "lucide-react": "^1.41.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "publint": "^0.3.24",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "totorobot": "^3.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  }
}

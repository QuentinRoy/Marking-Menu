{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "allowJs": true,
    "checkJs": true,
    // The demo (`demo/index.html`) resolves `marking-menu` through its
    // import map (see the `lib` symlink to `../dist`); this is what gives
    // the compiler its types for that specifier.
    "paths": { "marking-menu": ["../src/index.ts"] }
  },
  // The playground (see `demo/playground`) is its own project (jsx, React
  // types), not plain checkJs.
  "include": ["**/*.js", "**/*.ts"],
  "exclude": ["playground/**"]
}

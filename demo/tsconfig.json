{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "allowJs": true,
    "checkJs": true,
    // The demo (`demo/index.html`) resolves `marking-menu` through its
    // import map (see `demo/lib/marking-menu.js`, a symlink to
    // `../dist/marking-menu.js`); this is what gives the compiler its types for
    // that specifier.
    "paths": { "marking-menu": ["../src/index.ts"] }
  },
  "include": ["**/*.js", "**/*.ts"],
  "exclude": [
    // Its own project (jsx, React types), not plain checkJs.
    "playground/**",
    // The built library itself, symlinked in for the browser; already
    // checked as its own source in `../tsconfig.app.json`.
    "lib/**"
  ]
}
